{
  "name": "@hims/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Shared UI components and design tokens (rule of two)",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/styles/theme.css",
    "./eslint-plugin": "./eslint-plugin.mjs",
    "./eslint-react": "./eslint-react.mjs",
    "./check-css-colours": "./scripts/check-css-colours.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist .turbo",
    "lint": "eslint . --max-warnings=0 && node scripts/check-css-colours.mjs src",
    "test": "vitest run",
    "catalogue": "ladle serve --port 61000",
    "catalogue:build": "ladle build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "radix-ui": "^1.7.0",
    "react-hook-form": "^7.89.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@hims/config": "workspace:*",
    "@ladle/react": "^5.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  }
}
