{
  "name": "@hims/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared tsconfig, ESLint and Vitest presets for every workspace",
  "type": "module",
  "files": [
    "tsconfig.base.json",
    "eslint-preset.mjs",
    "vitest-preset.mjs"
  ],
  "exports": {
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./eslint": "./eslint-preset.mjs",
    "./vitest": "./vitest-preset.mjs"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "clean": "rm -rf coverage .turbo"
  },
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.0.0",
    "vitest": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@vitest/coverage-v8": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  }
}
