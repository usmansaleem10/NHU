  },
  "devDependencies": {
    "@hims/config": "workspace:*",
    "@vitest/coverage-v8": "^5.0.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@orpc/client": "^1.15.5",
    "@orpc/contract": "^1.15.5",
    "@orpc/openapi-client": "^1.15.5",
    "zod": "^4.6.5"
  }
}
