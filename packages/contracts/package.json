{
  "name": "@hims/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Zod contracts shared by api and web (the API contract)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
