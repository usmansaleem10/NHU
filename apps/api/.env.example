# Copy to apps/api/.env for `pnpm --filter @hims/api dev|start`.
# NODE_ENV is required (the dev script defaults it to development).
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
APP_RELEASE=dev
# API reference at /api/docs (keep off in production unless intended).
API_DOCS_ENABLED=true
# Adopt an incoming x-request-id only behind a trusted proxy.
TRUST_PROXY_REQUEST_ID=false
# Required in production (32+ chars); dev uses a random per-process key.
# CURSOR_SECRET=
