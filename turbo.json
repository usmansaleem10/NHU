{
  "$schema": "https://turborepo.com/schema.json",
  "cacheMaxAge": "7d",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.spec.ts"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/eslint.config.mjs",
        "$TURBO_ROOT$/packages/config/eslint-preset.mjs",
        "$TURBO_ROOT$/packages/config/src/eslint/**"
      ]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "NODE_ENV",
        "PORT",
        "HOST",
        "LOG_LEVEL",
        "DATABASE_*",
        "POSTGRES_*",
        "PGBOUNCER_*",
        "REDIS_*",
        "GOTENBERG_*",
        "MAILPIT_*",
        "SMTP_*",
        "SMS_*",
        "SESSION_*",
        "API_*",
        "VITE_*"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/config/vitest-preset.mjs"],
      "outputs": ["coverage/**"]
    },
    "test:int": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["DATABASE_*", "DOCKER_*", "TESTCONTAINERS_*"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["PLAYWRIGHT_*", "BASE_URL", "CI", "DATABASE_*"]
    },
    "db:generate": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["DATABASE_*"]
    },
    "db:migrate": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["DATABASE_*"]
    },
    "db:seed": {
      "dependsOn": ["^build", "db:migrate"],
      "cache": false,
      "passThroughEnv": ["DATABASE_*"]
    }
  }
}
